# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=3002
LOG_LEVEL=INFO
# The database catalog (property-catalog-db). Required: without it the service does not start.
# PERSISTENCE=memory (in-memory, nothing persists) is for tests and local development only.
PERSISTENCE=mongo
DATABASE_URL=mongodb://localhost:27017/catalog?directConnection=true
DATABASE_USER=catalog_app
DATABASE_PASSWORD=
# Limits of the pool and of each operation (Annex C, numeral 5.3.10).
DB_POOL_MAX=10
DB_POOL_WAIT_MS=5000
DB_TIMEOUT_MS=5000
# Limits of the HTTP server.
HTTP_KEEP_ALIVE_S=60
SHUTDOWN_TIMEOUT_S=20
# Integration tests run only when TEST_DATABASE_URL is set (Annex C).
TEST_DATABASE_URL=
TEST_DATABASE_USER=catalog_app
TEST_DATABASE_PASSWORD=
